# Copy to .env and fill in. .env is gitignored and never committed.

# FRED API key (free): https://fred.stlouisfed.org/docs/api/api_key.html
# Leave blank to run macro ingestion in synthetic/offline mode.
ETF_INTEL_FRED_API_KEY=

# Override data directory if desired (default: ./data)
# ETF_INTEL_DATA_DIR=./data

# Data source for market ingestion: "yfinance" (live) or "synthetic" (offline/CI)
ETF_INTEL_MARKET_SOURCE=yfinance
ETF_INTEL_MACRO_SOURCE=fred
